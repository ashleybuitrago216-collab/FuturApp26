  <p><strong>Ubicacion:</strong> <code>src/app/layouts/AppShell.jsx</code>.</p>
  <p><strong>Responsabilidad:</strong> sidebar, navegacion por rol, badge de notificaciones y cierre de sesion.</p>
  <pre>{item.id === "notificaciones" && unread &gt; 0 && (
  &lt;span&gt;{unread}&lt;/span&gt;
)}</pre>

